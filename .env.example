# Copy to .env and set the two secrets before starting Compose.
POSTGRES_DB=howsyourdayserver
POSTGRES_USER=postgres
# Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=
APP_PORT=8080
APP_DEFAULT_TIMEZONE=UTC
# Set only when a reverse proxy forwards requests to the app.
APP_TRUSTED_PROXY=
JWT_ISSUER=howsyourday
JWT_AUDIENCE=howsyourday-web
# Generate with: openssl rand -hex 64
JWT_KEY=
