# Copy this file to .env and fill in the values before running Docker Compose.
POSTGRES_DB=howsyourdayserver
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
JWT_ISSUER=howsyourday
JWT_AUDIENCE=howsyourday-web
# Generate one with: openssl rand -base64 64
JWT_KEY=replace-this-with-a-random-secret-that-is-at-least-64-characters-long
