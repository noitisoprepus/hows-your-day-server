@if (Rating is >= DayEntry.MinRating and <= DayEntry.MaxRating)
{
    var path = $"icons/weather/{IconNames[Rating - DayEntry.MinRating]}.svg";
    <img src="@Assets[path]" width="28" height="28" alt="" />
}

@code {
    private static readonly string[] IconNames =
    [
        "cloud-lightning", "cloud-rain-wind", "cloud-rain", "cloud-drizzle", "cloud-fog",
        "cloud", "cloud-sun", "sun-dim", "sun-medium", "sun"
    ];

    [Parameter, EditorRequired] public int Rating { get; set; }
}
