@page "/login"
@layout AccountLayout

<PageTitle>Sign in · HowsYourDay</PageTitle>
<h1>Sign in</h1>
@if (Registered)
{
    <p role="status">Your account is ready. Sign in to get started.</p>
}
@if (Error is "required" or "credentials")
{
    <p class="error" role="alert">@(Error == "required" ? "Enter your username and password." : "Unable to sign in. Check your credentials or try again later.")</p>
}
<form class="account-form" method="post" action="/ui/account/login">
    <AntiforgeryToken />
    <label for="username">Username</label>
    <input id="username" name="userName" autocomplete="username" required />
    <label for="password">Password</label>
    <input id="password" name="password" type="password" autocomplete="current-password" required />
    <button type="submit">Sign in</button>
</form>
<p>New here? <a href="/register">Create an account</a></p>

@code {
    [SupplyParameterFromQuery] public string? Error { get; set; }
    [SupplyParameterFromQuery] public bool Registered { get; set; }
}
